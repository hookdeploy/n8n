{
	"name": "n8n-nodes-hookdeploy",
	"version": "1.0.2",
	"description": "n8n community node for HookDeploy — webhook capture, inspection, routing, and private tunnel infrastructure.",
	"license": "MIT",
	"homepage": "https://hookdeploy.dev",
	"keywords": [
		"n8n-community-node-package",
		"hookdeploy",
		"webhooks"
	],
	"author": {
		"name": "Michael Bernstein",
		"email": "michael@hookdeploy.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hookdeploy/n8n"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "node scripts/dev.mjs",
		"dev:latest": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/HookDeployApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/HookDeploy/HookDeploy.node.js",
			"dist/nodes/HookDeploy/HookDeployTrigger.node.js"
		]
	},
	"engines": {
		"node": ">=20.19"
	},
	"devDependencies": {
		"@n8n/node-cli": "0.35.1",
		"eslint": "9.29.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"peerDependenciesMeta": {
		"n8n-workflow": {
			"optional": true
		}
	},
	"overrides": {
		"undici": "6.27.0",
		"lodash": "4.18.1",
		"js-yaml": "4.3.0",
		"form-data": "4.0.6",
		"uuid": "11.1.1",
		"minimatch": "9.0.7",
		"minimatch@3": {
			"brace-expansion": "1.1.17"
		},
		"minimatch@5": {
			"brace-expansion": "2.1.3"
		},
		"minimatch@9": {
			"brace-expansion": "2.1.3"
		},
		"minimatch@10": {
			"brace-expansion": "5.0.8"
		},
		"brace-expansion@1": "1.1.17",
		"brace-expansion@2": "2.1.3",
		"brace-expansion@5": "5.0.8"
	}
}
